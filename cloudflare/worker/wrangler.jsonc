{
  "name": "pandemic-game",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["python_workers"],
  // `public/` is built by scripts/sync.sh: web/dist (the built frontend).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // "/" and "/?room=..." links are served as static assets; the SPA fallback covers other paths.
    "not_found_handling": "single-page-application",
    // Everything in docs/SERVER_PROTOCOL.md goes through the Worker.
    "run_worker_first": ["/rooms", "/rooms/*", "/meta", "/ws/*"]
  },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }] },
  // Keep v1 as-is: it is the migration the first deploy already applied to this Worker name; do not renumber it.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  // Workers Logs: every request/WebSocket event and any errors, viewable in the dashboard's
  // Observability tab. This file is the source of truth: a deploy applies it over any dashboard
  // change. See docs/CLOUDFLARE.md.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
